
 {
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "Lumina-admin-9cdgmeipftcqalb75qghp",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-24",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "!/api/docs/*"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "mghdb",
			"database_name": "mghdb",
			"database_id": "405220ed-2c0c-4a8f-853a-140c34abb09c"
		}
	],
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "mgh-prop-images"
		}
	]
}
